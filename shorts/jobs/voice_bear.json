       "x": 0.12,
       "y": 0.32,
       "zoom": 1.6,
       "speed": 0.6
      },
      {
       "src": "h4",
       "t": 16.3,
       "x": 0.35
      }
     ]
    },
    {
     "text": "Protesters block an animal services truck and want the driver to free a bear.",
     "shots": [
      {
       "src": "h4",
       "t": 21.1,
       "x": 0.5,
       "speed": 0.8,
       "whoosh": true
      }
     ]
    },
    {
     "text": "One of them is just filming it all for content.",
